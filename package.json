{
  "name": "wechat-minigames-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run check:layout && npm run check --workspaces --if-present",
    "check:layout": "node tools/check-monorepo-layout.cjs",
    "check:mcp": "node tools/check-mcp.cjs minigame cloudbase wechatide",
    "build:breakfast": "npm run build:wechatgame --workspace=breakfast-stall",
    "dev:cocos:breakfast": "npm run dev:cocos --workspace=breakfast-stall"
  },
  "workspaces": [
    "games/*",
    ".tooling"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
